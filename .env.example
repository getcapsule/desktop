# Copy to .env and fill in. Every value is optional the app runs without any
# of them, with the corresponding feature disabled rather than crashing.

# ── Integrations (Phase 5) ──────────────────────────────────
# Compile-time, read via option_env!(). Forks supply their own.
# A key compiled into a distributed binary is extractable if you
# redistribute builds, use your own keys.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
DISCORD_CLIENT_ID=

# ── Apple metadata token path (optional) ────────────────────
# Used for metadata access only; Apple playback has been removed.
# Public URL imports also accept a developer token in Settings → Import.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=

# ── Dev / debug ─────────────────────────────────────────────
# Runtime, read via std::env no rebuild needed to change these.
RUST_LOG=info

# ── Navidrome (optional, runtime) ───────────────────────────
# Overrides [navidrome] in config.toml and the stored password.
# All three or none a partial set is ignored with a warning.
# Development convenience only: the password sits here in plaintext. The
# connect screen puts it in the OS credential store instead.
# NAVIDROME_URL=https://music.example.com
# NAVIDROME_USER=deniz
# NAVIDROME_PASSWORD=

# ── Path overrides (optional, runtime) ──────────────────────
# Default to the platform AppData dirs when unset.
# CAPSULE_DB_PATH=
# CAPSULE_ARTWORK_CACHE_PATH=
